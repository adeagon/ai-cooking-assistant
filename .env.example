# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_INTENT_MODEL=intent-classifier

# Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Data Paths
CHROMA_PERSIST_DIR=data/chroma
SQLITE_DB_PATH=data/sqlite/app.db

# Logging
LOG_LEVEL=INFO

# Retrieval Parameters
K_RETRIEVE=30
K_RERANK=10
K_CONTEXT=4
CONTEXT_LENGTH=8192

# ============================================
# Web Application Settings
# ============================================

# Environment mode: development or production
ENV=development

# Server binding
# 0 = localhost only (default, most secure)
# 1 = bind to 0.0.0.0 (allows LAN access)
ALLOW_LAN=0

# Port for web server (default: 5000)
PORT=5000

# Flask secret key (REQUIRED for production or when ALLOW_LAN=1)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-secret-key-here

# Initial setup token for first-login password setup
# Required when ENV=production or ALLOW_LAN=1
# INITIAL_SETUP_TOKEN=your-setup-token-here

# Allow guest login (development only)
ALLOW_GUEST_LOGIN=0

# Ollama concurrency settings
OLLAMA_NUM_PARALLEL=2
WEB_WORKERS=2
